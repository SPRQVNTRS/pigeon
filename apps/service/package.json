{
  "name": "@sprqvntrs/pigeon-service",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#build/*": "./build/*",
    "#drizzle/*": "./drizzle/*",
    "#db/*": "./drizzle/*",
    "#types/*": "./types/*",
    "#config": "./app/config/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1032.0",
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/client-ses": "^3.1036.0",
    "@aws-sdk/client-sesv2": "^3.1032.0",
    "@aws-sdk/client-sns": "^3.1032.0",
    "@aws-sdk/client-sts": "^3.1032.0",
    "@conform-to/react": "^1.21.3",
    "@conform-to/zod": "^1.21.3",
    "@paralleldrive/cuid2": "^2.3.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/express": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "@sprqvntrs/helpers": "^0.2.2",
    "@sprqvntrs/llm": "^3.14.1",
    "@sprqvntrs/logger": "^1.0.2",
    "@sprqvntrs/workflows": "^0.2.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^14.0.2",
    "compression": "^1.8.2",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "isbot": "^5.1.32",
    "lucide-react": "^0.475.0",
    "mailparser": "^3.9.8",
    "markdown-it": "^14.3.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5",
    "remix-auth": "^4.2.0",
    "remix-auth-form": "^3.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.21.0",
    "use-session-storage-state": "^19.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.6.7",
    "@sprqvntrs/pigeon": "workspace:*"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "tsx watch ./server.ts",
    "dev:server": "tsx ./server.ts",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "drizzle:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "drizzle:update": "tsx node_modules/drizzle-kit/bin.cjs generate && tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:seed": "tsx drizzle/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "content:validate": "tsx app/cms/validate.ts",
    "cli": "tsx ./cli/index.ts",
    "setup:aws": "tsx scripts/aws-setup.ts",
    "setup:aws:dev": "tsx scripts/aws-setup.ts",
    "setup:aws:inbound": "tsx scripts/aws-inbound.ts",
    "teardown:aws": "tsx scripts/aws-teardown.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
