# ============================================================
# Pigeon, Environment Variables
# ============================================================

# ----------------------------------------------------------
# REQUIRED, Server
# ----------------------------------------------------------
PORT=3601
APP_URL=http://localhost:3601
SESSION_SECRET=replace-with-a-long-random-string

# ----------------------------------------------------------
# REQUIRED, PostgreSQL
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pigeon
DB_SSL=false

# ----------------------------------------------------------
# REQUIRED, Superadmin seed credentials
# ----------------------------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-in-production

# ----------------------------------------------------------
# AWS, SES runtime credentials (required to send mail)
# ----------------------------------------------------------
# Option A: explicit keys (generated by pnpm setup:aws)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Option B: named profile, set AWS_PROFILE; SDK picks up credentials from
#   ~/.aws/credentials. The AWS scripts under apps/service/scripts use it too.
#   Do NOT set both options at the same time.
# AWS_PROFILE=<admin-profile>
# Required regardless of credential method:
AWS_REGION=eu-central-1
# AWS_SES_FROM_ADDRESS=mail@example.com
# AWS_SES_CONFIG_SET=pigeon          # dev default; use pigeon-prod in production

# Inbound mail (email.received). The only SNS topic POST /v1/webhooks/inbound
# accepts; unset turns inbound mail off (the route answers 503).
# scripts/aws-inbound.ts --apply prints the value.
# INBOUND_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:123456789012:pigeon-inbound-prod

# DMARC aggregate reports. The only SNS topic POST /v1/webhooks/dmarc accepts;
# unset turns DMARC report ingest off (the route answers 503).
# DMARC_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:123456789012:pigeon-dmarc-ingest-prod

# SES delivery, bounce and complaint events. The only SNS topic
# POST /v1/webhooks/ses accepts; unset turns SES event ingest off (the route
# answers 503, sending still works). scripts/aws-setup.ts prints the value.
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:000000000000:pigeon-ses-events

# DMARC rua address that tenant domains publish and the DNS health check
# expects. A bare address, no mailto: prefix; a bad value stops the boot.
# Default when unset: no address. The proposed DMARC record is then
# "v=DMARC1; p=none" and the health check accepts any DMARC record.
# PIGEON_DMARC_RUA=dmarc@dmarc.example.com

# ----------------------------------------------------------
# Security settings (apps/service/docs/security.md)
# ----------------------------------------------------------
# Per API key rate limit from api_keys.rate_limit_per_second: enforce | off.
# Over the limit a request gets 429 with Retry-After.
# Default when unset: enforce.
# PIGEON_RATE_LIMIT=enforce

# Webhook targets on loopback, private, link-local, CGNAT and other non-public
# addresses: deny | allow. Checked at registration and on every delivery.
# Default when unset: deny.
# PIGEON_WEBHOOK_PRIVATE_TARGETS=deny
# Local development only, to deliver webhooks to a receiver on localhost or a
# private address. Never set this on a deployment that takes tenant webhooks.
# PIGEON_WEBHOOK_PRIVATE_TARGETS=allow

# Exact host names (comma-separated) whose webhooks may resolve to a private
# network address (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) under
# deny, for split DNS. Loopback, link-local and metadata stay refused. No
# wildcards, ports, schemes or IP addresses; a bad entry stops the boot.
# Default when unset: no host listed.
# PIGEON_WEBHOOK_PRIVATE_HOSTS=hooks.example.com,internal.example.org

# ----------------------------------------------------------
# AWS scripts (apps/service/scripts), not read by the running service
# ----------------------------------------------------------
# setup:aws, setup:aws:inbound and their dry runs read these. There is no
# default: a missing one stops the script before any AWS call.
# PIGEON_PUBLIC_URL=https://pigeon.example.com    # public https base URL of this deployment
# PIGEON_INBOUND_BUCKET=example-pigeon-inbound    # S3 bucket for received tenant mail
# PIGEON_DMARC_BUCKET=example-dmarc-reports       # S3 bucket for DMARC aggregate reports
# PIGEON_DMARC_DOMAIN=dmarc.example.com           # domain that receives DMARC reports

# ----------------------------------------------------------
# Optional
# ----------------------------------------------------------
# HOST=127.0.0.1             # bind address; unset listens on every interface
# PIGEON_SERVICE_NAME=pigeon # tags every log line; default when unset: pigeon
# HMR_PORT=24678
# LOG_LEVEL=info
# DEBUG_MODE=false
# DB_POOL_MAX=10
# DB_POOL_MIN=2
