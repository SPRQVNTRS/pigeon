{
  "name": "@sprqvntrs/pigeon",
  "version": "3.0.1",
  "description": "TypeScript SDK for the Pigeon email service",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.config.contract.ts",
    "test:pack": "vitest run test/unit/published-shape.test.ts",
    "prepack": "tsup",
    "prepublishOnly": "tsup && vitest run test/unit/published-shape.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SPRQVNTRS/pigeon.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/SPRQVNTRS/pigeon/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/SPRQVNTRS/pigeon/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "email",
    "transactional",
    "ses",
    "aws",
    "sdk",
    "pigeon"
  ]
}
