{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"],
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false
  }
}
