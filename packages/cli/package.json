{
  "name": "@sprqvntrs/pigeon-cli",
  "version": "0.1.0",
  "description": "Admin CLI for a self-hosted Pigeon email service: apps, keys, domains, webhooks, inbound mail and pigeon.toml manifests",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "pigeon": "./src/cli.ts"
  },
  "scripts": {
    "pigeon": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:race": "node --import tsx tests/race/race.ts"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^16.6.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
